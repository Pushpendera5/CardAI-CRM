# ─────────────────────────────────────────────────────────────
#  CardAI CRM – environment configuration template
#  Copy to .env and fill in all REQUIRED values before running.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
APP_NAME=CardAI CRM

# REQUIRED in production. Options: local | dev | staging | prod | test
APP_ENV=local

# Set to false in production (automatically forced off when APP_ENV=prod)
APP_DEBUG=false

# ── CORS ─────────────────────────────────────────────────────
# The origin of your frontend (e.g. https://app.yourdomain.com)
FRONTEND_ORIGIN=http://localhost:8000

# Optional: comma-separated extra CORS origins
# EXTRA_CORS_ORIGINS=https://other.example.com

# ── Database ─────────────────────────────────────────────────
# REQUIRED: Update host/credentials for your environment
DATABASE_URL=mssql+pyodbc://sa:YourStrong!Passw0rd@mssql:1433/CardAICRM?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Security ─────────────────────────────────────────────────
# REQUIRED: Replace with a long random secret (min 32 chars).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── File uploads ─────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10

# ── OCR ──────────────────────────────────────────────────────
OCR_LANGUAGES=en

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=120
